# ── offline protocol eval: one checkpoint against every reference corpus ──────
# Same measurement the training loop writes as EVAL lines (400 docs, minlen 512, maxlen
# 1024, clean/median/runaway with exp/score.py's per-token criterion), so these numbers are
# directly comparable to a run's own EVAL curve and to any other checkpoint scored this way.
# NOTE the corpora are NOT comparable to EACH OTHER -- each has its own information floor.
# NOTE --synth_eval_docs 500 MUST match the training run's, or the synth column is
# scored on a different cached file (the cache is keyed by that count) and is not
# comparable to the run's own EVAL lines.  --eval_docs then takes the first 400.
# NOTE web forces non-streaming: its held-out is the sliced split train[-3000:], which
# datasets cannot stream, and that slice is what every web number in PLAN.txt uses.
python vla.py --eval --load checkpoint/s1_synth_100m.10000.pt \
    --eval_corpora synth,pile,web,c4 --eval_docs 400 --synth_eval_docs 500 \
    --streaming --device cuda \
    --eval_json exp/eval.s1_synth_100m.10000.json

