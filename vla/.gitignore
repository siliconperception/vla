# dolma3 corpus: the downloaded repo (110 GB) and the parquet parts dolma3_prep.py
# rewrites it into (~110 GB). Both are regenerable, neither belongs in git.
dolma3/
dolma3_text/

# 13 GB of trained weights; regenerable from the logs and PLAN.txt, and far too
# large for git. Kept on disk under ./checkpoint for review alongside ./log.
checkpoint/

# 36 MB of chain-of-thought text, regenerable from the Hub with reasoning_prep.py.
# Same rule as dolma3/ and checkpoint/: large and reproducible does not belong in git.
# vocab_phase*.txt and math_phase1.txt ARE tracked -- ~400 KB each and not redownloadable.
reasoning_phase1.txt
